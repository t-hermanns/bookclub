# Copy to .env.local for `npm run dev`, or to .env for `docker compose`.

# Signs the session cookie. Production refuses a missing or placeholder value.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me

# Everyone who can log in (comma-separated) and which of them is the admin.
PARTICIPANTS=Alice,Bob,Carol,Dave,Erin
ADMIN_NAME=Alice

# Password the admin enters at login. No default; production refuses a placeholder.
ADMIN_PASSWORD=change-me

# Voting system for new rounds: single (1 vote per person) or three_votes (3 votes per person).
VOTING_SYSTEM=single
